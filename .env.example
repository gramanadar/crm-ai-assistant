# Names only. Do not put live secrets in this file.

DATABASE_URL=postgresql+psycopg://assistant:assistant@db:5432/assistant
DATA_DIR=./data

LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

MODEL_ASK=claude-opus-5-5
MODEL_CLASSIFY=claude-opus-5-5
MODEL_AGENT=claude-opus-5-5
OPENAI_MODEL_ASK=gpt-4.1
OPENAI_MODEL_CLASSIFY=gpt-4.1-mini
OPENAI_MODEL_AGENT=gpt-4.1

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=1536

CHUNK_TARGET_MIN_TOKENS=500
CHUNK_TARGET_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.12

RETRIEVAL_TOP_K=8
SIMILARITY_FLOOR=0.2

CATEGORIES=billing,technical,account,sales,other
CLASSIFY_CONFIDENCE_THRESHOLD=0.75
CLASSIFY_DOUBLE_CHECK=false

MAX_DOCUMENTS=10
LOW_TEXT_CHAR_THRESHOLD=20

CRM_BASE_URL=sandbox
CRM_READ_TOKEN=
CRM_WRITE_TOKEN=
CRM_CONNECT_TIMEOUT=3
CRM_READ_TIMEOUT=10
CRM_CIRCUIT_THRESHOLD=3
CRM_CIRCUIT_OPEN_SECONDS=60

N8N_WEBHOOK_URL=
N8N_SIGNING_SECRET=
N8N_INLINE=true
WEBHOOK_MAX_AGE_SECONDS=300
PUBLIC_APP_URL=http://localhost:3000

DAILY_TOKEN_CEILING=0
PRICE_TABLE_JSON={"claude-opus-5-5":{"input":15,"output":75,"cache_read":1.5,"cache_write":18.75},"gpt-4.1":{"input":2,"output":8,"cache_read":0.5,"cache_write":0},"gpt-4.1-mini":{"input":0.4,"output":1.6,"cache_read":0.1,"cache_write":0},"text-embedding-3-small":{"input":0.02,"output":0,"cache_read":0,"cache_write":0},"local-hash-v1":{"input":0,"output":0,"cache_read":0,"cache_write":0}}

LLM_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=5
AGENT_TIME_BUDGET_SECONDS=30

DEBUG_LOG_BODIES=false
LOG_LEVEL=INFO

AUTH_TOKENS=user:dev-user-token,reviewer:dev-reviewer-token,approver:dev-approver-token

CATEGORY_CHANNELS_JSON={"billing":"billing@example.com","technical":"technical@example.com","account":"account@example.com","sales":"sales@example.com","other":"support@example.com","review":"review@example.com"}
